# 毕业版本地部署变量。复制为 deploy/.env 后填写；空值会导致启动失败。
# 不要提交 deploy/.env，也不要填入任何生产环境凭据。

# development | production
APP_ENV=production

# PostgreSQL（独立 bysj 项目，不使用任何生产地址）
POSTGRES_DB=bysj
POSTGRES_USER=bysj
# 必填：至少 12 位随机口令
DB_PASSWORD=
# 宿主端口，仅绑定 127.0.0.1
DB_PORT=5433

# API 与前端宿主端口（仅绑定 127.0.0.1）
API_PORT=8000
FRONTEND_PORT=8080

# 必填：至少 32 字符随机串；生成示例：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# 首次启动创建的管理员；密码必填，系统不会生成默认弱口令
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

PUBLIC_ORIGIN=http://127.0.0.1:8080

# 容器内路径（对应 compose 命名卷）
DATA_ROOT=/data
MODEL_ROOT=/models
ARTIFACT_ROOT=/artifacts

# 上传与推理限制（字节/数量）；调整需同步测试
MAX_IMAGE_BYTES=20971520
MAX_UPLOAD_BYTES=536870912
MAX_ZIP_FILES=10000
MAX_EXTRACT_BYTES=2147483648
MAX_COMPRESSION_RATIO=100
MAX_IMAGE_PIXELS=40000000
MAX_BATCH_INFERENCE=100

# auto|dummy|ultralytics；生产必须是 ultralytics
ML_BACKEND=ultralytics
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
GPU_LEASE_SECONDS=600
