# 本机开发示例；复制为 .env 并填写。Docker 使用 deploy/.env.example。
APP_ENV=development
DATABASE_URL=
JWT_SECRET_KEY=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
DATA_ROOT=./.data/data
MODEL_ROOT=./.data/models
ARTIFACT_ROOT=./.data/artifacts
INLINE_JOBS=false
ML_BACKEND=ultralytics
PUBLIC_ORIGIN=http://127.0.0.1:3000

# --- 胸片五标签（cxr_multilabel / cxr-five-v1）---
# 只读来源根目录；API 只接受已配置的 source_id，不接受任意服务器路径。
# CXR_IMPORT_ROOT=D:/data/chexpert
# 或显式 source_id -> 目录映射（优先于 CXR_IMPORT_ROOT），JSON：
# CXR_SOURCES={"chexpert-local":"D:/data/chexpert"}
# auto|densenet121|dummy；dummy 只用于工程契约测试
CXR_ML_BACKEND=auto
# 合成 fixture 默认拒绝；仅工程验证时显式开启，不得用于研究结论
CXR_ALLOW_SYNTHETIC=false
